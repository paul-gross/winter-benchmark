diff --git a/tests/conftest.py b/tests/conftest.py
new file mode 100644
index 0000000..d538e4d
--- /dev/null
+++ b/tests/conftest.py
@@ -0,0 +1,44 @@
+"""Shared fixtures for the persistence test suite.
+
+These tests run against the real Postgres named by ``DATABASE_URL`` (the same
+database the live api/worker point at in a feature env). To avoid clobbering or
+leaking rows into that shared data, every test-created row carries a per-run
+marker in its ``label`` and the ``repo`` fixture deletes exactly those rows on
+teardown — including any left behind by a failing test.
+"""
+
+from __future__ import annotations
+
+import uuid
+from collections.abc import Iterator
+
+import pytest
+from sqlalchemy import delete
+
+from wts_persistence.internal.engine import create_db_engine
+from wts_persistence.internal.entities import ItemEntity
+from wts_persistence.internal.item_repository import WriteItemRepository
+from sqlalchemy.orm import Session
+
+
+@pytest.fixture
+def marker() -> str:
+    """A label prefix unique to this test, so cleanup never touches live rows."""
+    return f"__pytest__{uuid.uuid4().hex}__"
+
+
+@pytest.fixture
+def repo(marker: str) -> Iterator[WriteItemRepository]:
+    """A live WriteItemRepository, with marker-scoped row cleanup on teardown."""
+    engine = create_db_engine()
+    repository = WriteItemRepository(engine)
+    try:
+        yield repository
+    finally:
+        # Belt-and-braces: remove any row this test created, even on failure.
+        with Session(engine) as session:
+            session.execute(
+                delete(ItemEntity).where(ItemEntity.label.like(f"{marker}%"))
+            )
+            session.commit()
+        engine.dispose()
diff --git a/tests/test_item_repository.py b/tests/test_item_repository.py
new file mode 100644
index 0000000..3b6b2ce
--- /dev/null
+++ b/tests/test_item_repository.py
@@ -0,0 +1,49 @@
+"""Runtime tests for WriteItemRepository.delete_item against a real Postgres.
+
+Exercises the delete path end to end: the happy path (row is actually gone) and
+the missing-id path (ItemNotFoundError propagates and is not swallowed by the
+repository's SQLAlchemyError wrapping).
+"""
+
+from __future__ import annotations
+
+import pytest
+from sqlalchemy.orm import Session
+
+from wts_persistence.domain.errors import ItemNotFoundError
+from wts_persistence.domain.item import ItemSource
+from wts_persistence.internal.entities import ItemEntity
+from wts_persistence.internal.item_repository import WriteItemRepository
+
+
+def _row_exists(repo: WriteItemRepository, item_id: int) -> bool:
+    with Session(repo._engine) as session:
+        return session.get(ItemEntity, item_id) is not None
+
+
+def test_delete_item_removes_existing_row(
+    repo: WriteItemRepository, marker: str
+) -> None:
+    created = repo.add_item(f"{marker}to-delete", ItemSource.API)
+    assert _row_exists(repo, created.id)
+
+    repo.delete_item(created.id)
+
+    # Gone from a direct row lookup...
+    assert not _row_exists(repo, created.id)
+    # ...and gone from the read seam consumers actually use.
+    assert created.id not in {item.id for item in repo.list_items(limit=1000)}
+
+
+def test_delete_item_missing_id_raises_not_found(
+    repo: WriteItemRepository, marker: str
+) -> None:
+    # Create a row then delete it, giving us an id that is guaranteed free.
+    created = repo.add_item(f"{marker}freed-id", ItemSource.WORKER)
+    repo.delete_item(created.id)
+    assert not _row_exists(repo, created.id)
+
+    # Deleting the now-absent id must raise ItemNotFoundError — and must NOT be
+    # caught and rewrapped as RepositoryError by the except SQLAlchemyError arm.
+    with pytest.raises(ItemNotFoundError):
+        repo.delete_item(created.id)
