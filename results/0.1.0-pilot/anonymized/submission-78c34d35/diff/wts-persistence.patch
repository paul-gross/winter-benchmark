 from sqlalchemy.exc import SQLAlchemyError
 from sqlalchemy.orm import Session
@@ -73,6 +73,17 @@ class WriteItemRepository(ReadItemRepository):
         except SQLAlchemyError as exc:
             raise self._wrap(exc, "failed to add item")
 
+    def delete_item(self, item_id: int) -> bool:
+        """Delete the item with `item_id`. Returns True if a row was removed."""
+        try:
+            with Session(self._engine) as session:
+                stmt = delete(ItemEntity).where(ItemEntity.id == item_id)
+                result = session.execute(stmt)
+                session.commit()
+                return result.rowcount > 0
+        except SQLAlchemyError as exc:
+            raise self._wrap(exc, "failed to delete item")
+
 
 def _to_domain(entity: ItemEntity) -> Item:
