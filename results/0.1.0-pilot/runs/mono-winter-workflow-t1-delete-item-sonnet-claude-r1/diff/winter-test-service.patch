+++ b/scripts/verify_item_api.sh
@@ -0,0 +1,149 @@
+#!/usr/bin/env bash
+#
+# verify_item_api.sh — runtime verification of the item API against a running stack.
+#
+# Exercises the full item lifecycle (health, create, list, delete) end-to-end
+# over HTTP, asserting status codes and observable persistence effects. This is
+# the durable, rerunnable method behind the `api:item-lifecycle` row of the
+# verifiability matrix (context/testing/verifiability-matrix.md).
+#
+# Usage:
+#   scripts/verify_item_api.sh [BASE_URL]
+#   BASE_URL defaults to $WTS_API_BASE_URL, then to http://localhost:7503
+#   (the api's default local port). In a winter feature env, pass the env's
+#   api base URL, e.g.  scripts/verify_item_api.sh http://localhost:6031
+#
+# Exit status is 0 iff every check passes; each check prints its request and the
+# observed status/body so a failure is self-describing.
+#
+# Requires: bash, curl, jq.
+
+set -uo pipefail
+
+BASE_URL="${1:-${WTS_API_BASE_URL:-http://localhost:7503}}"
+BASE_URL="${BASE_URL%/}"
+
+pass=0
+fail=0
+
+ok()   { printf '  PASS  %s\n' "$1"; pass=$((pass+1)); }
+bad()  { printf '  FAIL  %s\n' "$1"; fail=$((fail+1)); }
+info() { printf '        %s\n' "$1"; }
+
+# curl helper: response body is written to $BODY_FILE, the numeric HTTP status
+# is echoed to stdout. Callers do:  CODE=$(req METHOD PATH ...); BODY=$(cat "$BODY_FILE")
+# (The status is returned via stdout rather than a global so callers can invoke
+# req in a command substitution without losing it to the subshell.)
+BODY_FILE="$(mktemp)"
+trap 'rm -f "$BODY_FILE"' EXIT
+req() {
+  local method="$1" path="$2"; shift 2
+  curl -sS -X "$method" -o "$BODY_FILE" -w '%{http_code}' "$BASE_URL$path" "$@" \
+    || echo "000"
+}
+
+echo "== verify_item_api.sh against $BASE_URL =="
+
+# ---------------------------------------------------------------------------
+# Check 1: health still ok (regression guard for the existing surface)
+# ---------------------------------------------------------------------------
+code="$(req GET /api/health)"; h="$(cat "$BODY_FILE")"
+echo "REQ  GET  /api/health"
+info "-> HTTP $code  body=$h"
+if [ "$code" = "200" ] && [ "$(echo "$h" | jq -r '.status')" = "ok" ] \
+   && [ "$(echo "$h" | jq -r '.db')" = "ok" ]; then
+  ok "health returns 200 {status:ok, db:ok}"
+else
+  bad "health check did not return 200 {status:ok, db:ok}"
+fi
+
+# ---------------------------------------------------------------------------
+# Check 2: POST creates items (regression + setup). Create a "keeper" that
+# must survive the delete, and a "target" that we will delete.
+# ---------------------------------------------------------------------------
+keep_code="$(req POST /api/items -H 'Content-Type: application/json' -d '{"label":"verify-keeper"}')"
+keep="$(cat "$BODY_FILE")"
+KEEP_ID="$(echo "$keep" | jq -r '.id // empty')"
+echo "REQ  POST /api/items {\"label\":\"verify-keeper\"}"
+info "-> HTTP $keep_code  body=$keep"
+
+tgt_code="$(req POST /api/items -H 'Content-Type: application/json' -d '{"label":"delete-me"}')"
+tgt="$(cat "$BODY_FILE")"
+DEL_ID="$(echo "$tgt" | jq -r '.id // empty')"
+echo "REQ  POST /api/items {\"label\":\"delete-me\"}"
+info "-> HTTP $tgt_code  body=$tgt"
+
+if [ "$keep_code" = "201" ] && [ -n "$KEEP_ID" ] \
+   && [ "$tgt_code" = "201" ] && [ -n "$DEL_ID" ] \
+   && [ "$(echo "$tgt" | jq -r '.source')" = "api" ]; then
+  ok "POST /api/items creates items (201, source=api); keeper=$KEEP_ID target=$DEL_ID"
+else
+  bad "POST /api/items did not create items as expected"
+fi
+
+# Snapshot the id set before the delete (list is newest-first, capped at 100).
+req GET /api/items >/dev/null; before="$(cat "$BODY_FILE")"
+before_ids="$(echo "$before" | jq -r '.[].id' | LC_ALL=C sort)"
+
+# ---------------------------------------------------------------------------
+# Check 3: DELETE the target -> 204 with an empty body
+# ---------------------------------------------------------------------------
+code="$(req DELETE "/api/items/$DEL_ID")"; d="$(cat "$BODY_FILE")"
+echo "REQ  DELETE /api/items/$DEL_ID"
+info "-> HTTP $code  body=$(printf '%q' "$d")"
+if [ "$code" = "204" ] && [ -z "$d" ]; then
+  ok "DELETE existing id returns 204 with empty body"
+else
+  bad "DELETE existing id did not return 204/empty body"
+fi
+
+# ---------------------------------------------------------------------------
+# Check 4: after delete, target is gone; keeper survives; nothing else vanished.
+# ---------------------------------------------------------------------------
+req GET /api/items >/dev/null; after="$(cat "$BODY_FILE")"
+after_ids="$(echo "$after" | jq -r '.[].id' | LC_ALL=C sort)"
+echo "REQ  GET  /api/items  (post-delete)"
+target_absent=true
+keeper_present=false
+echo "$after_ids" | grep -qx "$DEL_ID" && target_absent=false
+echo "$after_ids" | grep -qx "$KEEP_ID" && keeper_present=true
+
+# Ids present before but not after, excluding the intended target. The worker
+# only ever inserts rows, so the only legitimate disappearance is the target
+# itself. (Caveat: the list endpoint returns at most 100 rows newest-first; if
+# the table exceeds ~100 rows during the run, an old id can fall out of the
+# window without being deleted. This check is exact while under that cap.)
+unexpected_gone="$(comm -23 <(echo "$before_ids") <(echo "$after_ids") | grep -vx "$DEL_ID" || true)"
+
+info "target_absent=$target_absent keeper_present=$keeper_present unexpected_removed=[${unexpected_gone//$'\n'/,}]"
+if $target_absent && $keeper_present && [ -z "$unexpected_gone" ]; then
+  ok "deletion removed exactly the target row; keeper and all other rows intact"
+else
+  bad "deletion did not remove exactly one row as expected"
+fi
+
+# ---------------------------------------------------------------------------
+# Check 5: DELETE a nonexistent id -> 404
+# ---------------------------------------------------------------------------
+code="$(req DELETE /api/items/999999999)"; n="$(cat "$BODY_FILE")"
+echo "REQ  DELETE /api/items/999999999"
+info "-> HTTP $code  body=$n"
+if [ "$code" = "404" ]; then
+  ok "DELETE nonexistent id returns 404"
+else
+  bad "DELETE nonexistent id did not return 404"
+fi
+
+# Bonus: deleting the already-deleted target is now also a 404 (not-found is
+# consistent), reinforcing that the row is truly gone.
+code="$(req DELETE "/api/items/$DEL_ID")"; n2="$(cat "$BODY_FILE")"
+echo "REQ  DELETE /api/items/$DEL_ID  (already deleted)"
+info "-> HTTP $code  body=$n2"
+if [ "$code" = "404" ]; then
+  ok "re-DELETE of the deleted id returns 404"
+else
+  bad "re-DELETE of the deleted id did not return 404"
+fi
+
+echo "== done: $pass passed, $fail failed =="
+[ "$fail" -eq 0 ]
