diff --git a/tests/conftest.py b/tests/conftest.py
new file mode 100644
index 0000000..63dd203
--- /dev/null
+++ b/tests/conftest.py
@@ -0,0 +1,50 @@
+"""Shared fixtures for the api test suite.
+
+These are runtime tests: they drive the real FastAPI app in-process via
+``TestClient`` against the same Postgres named by ``DATABASE_URL`` that the live
+api/worker point at in a feature env (mirroring the wts-persistence suite). To
+avoid clobbering or leaking rows into that shared data, every item a test
+creates carries a per-run marker in its ``label`` and the ``client`` fixture
+deletes exactly those rows on teardown — including any left behind by a failing
+test.
+"""
+
+from __future__ import annotations
+
+import uuid
+from collections.abc import Iterator
+
+import pytest
+from fastapi.testclient import TestClient
+from sqlalchemy import delete
+from sqlalchemy.orm import Session
+
+from app.deps import get_engine
+from app.main import app
+from wts_persistence.internal.entities import ItemEntity
+
+
+@pytest.fixture
+def marker() -> str:
+    """A label prefix unique to this test, so cleanup never touches live rows."""
+    return f"__pytest__{uuid.uuid4().hex}__"
+
+
+@pytest.fixture
+def client(marker: str) -> Iterator[TestClient]:
+    """A TestClient over the real app, with marker-scoped row cleanup on teardown.
+
+    Entering the context manager runs the app's lifespan (schema init), so the
+    client exercises the same startup path the live service does.
+    """
+    with TestClient(app) as test_client:
+        try:
+            yield test_client
+        finally:
+            # Belt-and-braces: remove any row this test created, even on failure.
+            engine = get_engine()
+            with Session(engine) as session:
+                session.execute(
+                    delete(ItemEntity).where(ItemEntity.label.like(f"{marker}%"))
+                )
+                session.commit()
diff --git a/tests/test_items_api.py b/tests/test_items_api.py
new file mode 100644
index 0000000..d0b879c
--- /dev/null
+++ b/tests/test_items_api.py
@@ -0,0 +1,69 @@
+"""Runtime tests for the items HTTP surface, driven through the real app.
+
+Covers the Phase 2 "delete an item" route end to end — the happy-path delete
+(the item is actually gone and siblings are untouched) and the missing-id path
+(404 with the domain error message) — plus a regression pass over the endpoints
+delete must not have broken: health, list, and create.
+"""
+
+from __future__ import annotations
+
+from fastapi.testclient import TestClient
+
+
+def _create(client: TestClient, label: str) -> dict:
+    resp = client.post("/api/items", json={"label": label})
+    assert resp.status_code == 201, resp.text
+    return resp.json()
+
+
+# ---------------------------------------------------------------------------
+# DELETE /api/items/{id}
+# ---------------------------------------------------------------------------
+
+def test_delete_removes_only_that_item(client: TestClient, marker: str) -> None:
+    victim = _create(client, f"{marker}victim")
+    survivor = _create(client, f"{marker}survivor")
+
+    resp = client.delete(f"/api/items/{victim['id']}")
+    assert resp.status_code == 204
+    assert resp.content == b""  # 204 carries no body
+
+    ids = {item["id"] for item in client.get("/api/items").json()}
+    assert victim["id"] not in ids  # actually gone from the read seam
+    assert survivor["id"] in ids  # sibling untouched
+
+
+def test_delete_missing_id_returns_404(client: TestClient, marker: str) -> None:
+    # Create then delete a row, yielding an id guaranteed to be free.
+    freed = _create(client, f"{marker}freed")
+    assert client.delete(f"/api/items/{freed['id']}").status_code == 204
+
+    resp = client.delete(f"/api/items/{freed['id']}")
+    assert resp.status_code == 404
+    assert resp.json()["detail"] == f"item {freed['id']} not found"
+
+
+def test_delete_never_created_id_returns_404(client: TestClient) -> None:
+    resp = client.delete("/api/items/2147483647")
+    assert resp.status_code == 404
+    assert "not found" in resp.json()["detail"]
+
+
+# ---------------------------------------------------------------------------
+# Regression: endpoints the delete change must not have broken
+# ---------------------------------------------------------------------------
+
+def test_health_ok(client: TestClient) -> None:
+    resp = client.get("/api/health")
+    assert resp.status_code == 200
+    assert resp.json() == {"status": "ok", "db": "ok"}
+
+
+def test_create_and_list_item(client: TestClient, marker: str) -> None:
+    created = _create(client, f"{marker}listed")
+    assert created["source"] == "api"
+
+    listing = client.get("/api/items")
+    assert listing.status_code == 200
+    assert created["id"] in {item["id"] for item in listing.json()}
